@page "/gio-hang"
@model Demo1.Pages.Cart.IndexModel
@{ ViewData["Title"] = "Giỏ hàng"; }

<div class="page-hero compact"><div class="container"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-page="/Index">Trang chủ</a></li><li class="breadcrumb-item active">Giỏ hàng</li></ol></nav><h1>Giỏ hàng của bạn</h1></div></div>
<div class="container section-block">
    @if (Model.Cart.Items.Count == 0)
    { <div class="empty-state"><h2>Giỏ hàng đang trống</h2><p>Khám phá đồ bảo hộ và phụ kiện xe của Khada Moto Shop.</p><a class="btn btn-racing" asp-page="/Products/Index">Tiếp tục mua hàng</a></div> }
    else
    {
        <div class="row g-4"><div class="col-lg-8"><div class="cart-list">
            @foreach (var item in Model.Cart.Items)
            {
                <div class="cart-item">
                    <a asp-page="/Products/Details" asp-route-slug="@item.Slug"><img src="@(string.IsNullOrWhiteSpace(item.ImagePath) ? "/images/placeholder-product.svg" : item.ImagePath)" alt="@item.ProductName" /></a>
                    <div class="cart-main"><h2><a asp-page="/Products/Details" asp-route-slug="@item.Slug">@item.ProductName</a></h2><p>SKU: @item.Sku · Size: @item.Size · Màu: @item.Color</p><strong>@item.UnitPrice.ToVnd()</strong>@if (!item.IsAvailable || item.Quantity > item.StockQuantity) { <div class="text-danger mt-2">Sản phẩm không còn đủ số lượng.</div> }</div>
                    <div class="cart-actions"><form method="post" asp-page-handler="Update"><input type="hidden" name="productVariantId" value="@item.ProductVariantId" /><input class="form-control" type="number" name="quantity" min="1" max="@Math.Max(1, item.StockQuantity)" value="@item.Quantity" /><button class="btn btn-sm btn-dark mt-2" type="submit">Cập nhật</button></form><form method="post" asp-page-handler="Remove"><input type="hidden" name="productVariantId" value="@item.ProductVariantId" /><button class="btn btn-link text-danger p-0 mt-2" type="submit">Xóa</button></form><b>@item.LineTotal.ToVnd()</b></div>
                </div>
            }
        </div></div>
        <div class="col-lg-4"><aside class="order-summary"><h2>Tóm tắt đơn hàng</h2><div><span>Số lượng</span><b>@Model.Cart.TotalQuantity</b></div><div class="total"><span>Tạm tính</span><b>@Model.Cart.Subtotal.ToVnd()</b></div><p>Phí giao hàng được tính ở bước đặt hàng.</p>@if (Model.Cart.IsValid) { <a class="btn btn-racing btn-lg w-100" asp-page="/Checkout/Index">Đặt hàng COD</a> } else { <button class="btn btn-secondary btn-lg w-100" disabled>Vui lòng cập nhật giỏ</button> }</aside></div></div>
    }
</div>
