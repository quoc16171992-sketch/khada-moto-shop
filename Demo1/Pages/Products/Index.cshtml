@page "/san-pham"
@model Demo1.Pages.Products.IndexModel
@{ ViewData["Title"] = "Sản phẩm"; }

<div class="page-hero compact"><div class="container"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-page="/Index">Trang chủ</a></li><li class="breadcrumb-item active">Sản phẩm</li></ol></nav><h1>Đồ bảo hộ và đồ chơi xe</h1><p>Chọn phụ kiện phù hợp với phong cách và hành trình của bạn.</p></div></div>
<div class="container section-block">
    <form method="get" class="filter-panel mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-lg-3"><label asp-for="Search" class="form-label">Tìm theo tên</label><input asp-for="Search" class="form-control" placeholder="Nhập tên sản phẩm" /></div>
            <div class="col-6 col-lg-2"><label asp-for="Category" class="form-label">Danh mục</label><select asp-for="Category" class="form-select"><option value="">Tất cả</option>@foreach (var item in Model.Result.Categories) { <option value="@item.Slug">@item.Name</option> }</select></div>
            <div class="col-6 col-lg-2"><label asp-for="Size" class="form-label">Kích thước</label><select asp-for="Size" class="form-select"><option value="">Tất cả</option>@foreach (var item in Model.Result.Sizes) { <option value="@item">@item</option> }</select></div>
            <div class="col-6 col-lg-2"><label asp-for="Color" class="form-label">Màu sắc</label><select asp-for="Color" class="form-select"><option value="">Tất cả</option>@foreach (var item in Model.Result.Colors) { <option value="@item">@item</option> }</select></div>
            <div class="col-6 col-lg-3"><label asp-for="Sort" class="form-label">Sắp xếp</label><select asp-for="Sort" class="form-select"><option value="newest">Mới nhất</option><option value="price-asc">Giá thấp đến cao</option><option value="price-desc">Giá cao đến thấp</option></select></div>
            <div class="col-6 col-lg-3"><label asp-for="MinPrice" class="form-label">Giá tối thiểu</label><input asp-for="MinPrice" class="form-control" type="number" min="0" step="10000" /></div>
            <div class="col-6 col-lg-3"><label asp-for="MaxPrice" class="form-label">Giá tối đa</label><input asp-for="MaxPrice" class="form-control" type="number" min="0" step="10000" /></div>
            <div class="col-lg-6 d-flex gap-2"><button class="btn btn-racing flex-grow-1" type="submit">Áp dụng bộ lọc</button><a class="btn btn-outline-secondary" asp-page="/Products/Index">Xóa lọc</a></div>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Tìm thấy @Model.Result.TotalItems sản phẩm</h2></div>
    @if (Model.Result.Products.Count == 0)
    { <div class="empty-state"><h2>Không có sản phẩm phù hợp</h2><p>Hãy thử thay đổi từ khóa hoặc bộ lọc.</p><a class="btn btn-dark" asp-page="/Products/Index">Xem tất cả</a></div> }
    else
    {
        <div class="row g-4">@foreach (var product in Model.Result.Products) { <div class="col-6 col-lg-3"><partial name="_ProductCard" model="product" /></div> }</div>
    }

    @if (Model.Result.TotalPages > 1)
    {
        <nav class="mt-5" aria-label="Phân trang"><ul class="pagination justify-content-center">
            @for (var pageNo = 1; pageNo <= Model.Result.TotalPages; pageNo++)
            {
                <li class="page-item @(pageNo == Model.Result.PageNumber ? "active" : "")"><a class="page-link" asp-page="/Products/Index" asp-route-pageNumber="@pageNo" asp-route-search="@Model.Search" asp-route-category="@Model.Category" asp-route-size="@Model.Size" asp-route-color="@Model.Color" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice" asp-route-sort="@Model.Sort">@pageNo</a></li>
            }
        </ul></nav>
    }
</div>
