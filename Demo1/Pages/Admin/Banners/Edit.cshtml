@page "{id:int}"
@model Demo1.Pages.Admin.Banners.EditModel
@{ ViewData["Title"] = "Sửa banner"; }
<div class="container section-block admin-page"><partial name="_AdminNav" /><h1>Sửa banner</h1>@if (!string.IsNullOrWhiteSpace(Model.CurrentImagePath)) { <img class="admin-banner-preview my-3" src="@Model.CurrentImagePath" alt="Ảnh banner hiện tại" /> }<form method="post" enctype="multipart/form-data" class="content-panel"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-12"><label asp-for="Input.Title" class="form-label">Tiêu đề</label><input asp-for="Input.Title" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger"></span></div><div class="col-12"><label asp-for="Input.Subtitle" class="form-label">Mô tả</label><textarea asp-for="Input.Subtitle" class="form-control"></textarea></div><div class="col-md-6"><label asp-for="Input.ButtonText" class="form-label">Chữ trên nút</label><input asp-for="Input.ButtonText" class="form-control" /></div><div class="col-md-6"><label asp-for="Input.TargetUrl" class="form-label">Đường dẫn đích</label><input asp-for="Input.TargetUrl" class="form-control" /><span asp-validation-for="Input.TargetUrl" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Input.DisplayOrder" class="form-label">Thứ tự</label><input asp-for="Input.DisplayOrder" class="form-control" /></div><div class="col-md-4"><label asp-for="Input.StartAtLocal" class="form-label"></label><input asp-for="Input.StartAtLocal" class="form-control" type="datetime-local" /></div><div class="col-md-4"><label asp-for="Input.EndAtLocal" class="form-label"></label><input asp-for="Input.EndAtLocal" class="form-control" type="datetime-local" /><span asp-validation-for="Input.EndAtLocal" class="text-danger"></span></div><div class="col-md-8"><label asp-for="BannerImage" class="form-label">Thay ảnh mới</label><input asp-for="BannerImage" class="form-control" accept=".jpg,.jpeg,.png,.webp" /><span asp-validation-for="BannerImage" class="text-danger"></span></div><div class="col-md-4 d-flex align-items-end"><div class="form-check"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Đang bật</label></div></div></div><div class="mt-4 d-flex gap-2"><button class="btn btn-racing" type="submit">Lưu thay đổi</button><a class="btn btn-outline-secondary" asp-page="Index">Hủy</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
