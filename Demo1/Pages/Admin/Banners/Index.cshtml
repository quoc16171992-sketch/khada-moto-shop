@page
@model Demo1.Pages.Admin.Banners.IndexModel
@{ ViewData["Title"] = "Quản lý banner"; }
<div class="container section-block admin-page"><partial name="_AdminNav" /><div class="admin-title"><h1>Banner trang chủ</h1><a class="btn btn-racing" asp-page="Create">Thêm banner</a></div><div class="table-responsive content-panel p-0"><table class="table admin-table mb-0"><thead><tr><th>Ảnh</th><th>Nội dung</th><th>Thứ tự</th><th>Trạng thái</th><th>Thời gian</th><th></th></tr></thead><tbody>@foreach (var item in Model.Banners) { <tr><td>@if (!string.IsNullOrWhiteSpace(item.ImagePath)) { <img class="admin-thumb" src="@item.ImagePath" alt="@item.Title" /> } else { <span class="admin-thumb placeholder-thumb">K</span> }</td><td><b>@item.Title</b><small>@item.Subtitle</small></td><td>@item.DisplayOrder</td><td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Đang bật" : "Đang tắt")</span></td><td><small>@(item.StartAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Ngay") → @(item.EndAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Không giới hạn")</small></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-dark" asp-page="Edit" asp-route-id="@item.Id">Sửa</a> <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@item.Id">Xóa</a></td></tr> }</tbody></table></div></div>
