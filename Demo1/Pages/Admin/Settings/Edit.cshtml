@page
@model Demo1.Pages.Admin.Settings.EditModel
@{ ViewData["Title"] = "Sửa thông tin cửa hàng"; }
<div class="container section-block admin-page"><partial name="_AdminNav" /><h1>Sửa thông tin cửa hàng</h1><form method="post" class="content-panel mt-4"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Input.ShopName" class="form-label">Tên cửa hàng</label><input asp-for="Input.ShopName" class="form-control" /><span asp-validation-for="Input.ShopName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.PhoneNumber" class="form-label">Số điện thoại</label><input asp-for="Input.PhoneNumber" class="form-control" /><span asp-validation-for="Input.PhoneNumber" class="text-danger"></span></div><div class="col-12"><label asp-for="Input.FacebookUrl" class="form-label">Link Facebook</label><input asp-for="Input.FacebookUrl" class="form-control" placeholder="https://..." /><span asp-validation-for="Input.FacebookUrl" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" /><span asp-validation-for="Input.Email" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Input.SupportHours" class="form-label">Giờ hỗ trợ</label><input asp-for="Input.SupportHours" class="form-control" /></div><div class="col-12"><label asp-for="Input.Address" class="form-label">Địa chỉ</label><textarea asp-for="Input.Address" class="form-control"></textarea></div><div class="col-12"><label asp-for="Input.FooterDescription" class="form-label">Mô tả footer</label><textarea asp-for="Input.FooterDescription" class="form-control"></textarea></div></div><div class="mt-4 d-flex gap-2"><button class="btn btn-racing" type="submit">Lưu thay đổi</button><a class="btn btn-outline-secondary" asp-page="Index">Hủy</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
