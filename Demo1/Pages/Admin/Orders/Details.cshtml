@page "{id:int}"
@model Demo1.Pages.Admin.Orders.DetailsModel
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<div class="container section-block admin-page"><partial name="_AdminNav" /><div class="admin-title"><div><span class="eyebrow text-danger">ĐƠN HÀNG</span><h1>@Model.Order.OrderCode</h1><p>@Model.Order.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p></div><span class="status-pill status-@Model.Order.Status.ToString().ToLowerInvariant()">@Model.Order.Status.ToVietnamese()</span></div><div class="row g-4"><div class="col-lg-8"><div class="content-panel"><h2 class="h4">Sản phẩm</h2><div class="order-items">@foreach (var item in Model.Order.Items) { <div><span><b>@item.ProductName</b><small>@item.Sku · @item.Size · @item.Color · SL @item.Quantity</small></span><span>@item.UnitPrice.ToVnd()<small>@item.LineTotal.ToVnd()</small></span></div> }</div></div><div class="content-panel mt-4"><h2 class="h4">Khách hàng</h2><dl class="admin-details"><dt>Họ tên</dt><dd>@Model.Order.CustomerName</dd><dt>Số điện thoại</dt><dd>@Model.Order.PhoneNumber</dd><dt>Email</dt><dd>@(Model.Order.Email ?? "-")</dd><dt>Địa chỉ</dt><dd>@Model.Order.Address</dd><dt>Ghi chú</dt><dd>@(Model.Order.Note ?? "-")</dd></dl></div></div><div class="col-lg-4"><aside class="order-summary"><h2>Thanh toán</h2><div><span>Tạm tính</span><b>@Model.Order.Subtotal.ToVnd()</b></div><div><span>Phí giao hàng</span><b>@Model.Order.ShippingFee.ToVnd()</b></div><div class="total"><span>Tổng cộng</span><b>@Model.Order.TotalAmount.ToVnd()</b></div><hr /><form method="post"><label asp-for="NewStatus" class="form-label fw-bold">Cập nhật trạng thái</label><select asp-for="NewStatus" class="form-select mb-3" disabled="@(Model.Order.Status == OrderStatus.Cancelled)">@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status">@status.ToVietnamese()</option> }</select><button class="btn btn-racing w-100" type="submit" disabled="@(Model.Order.Status == OrderStatus.Cancelled)">Lưu trạng thái</button></form>@if (Model.Order.StockRestored) { <p class="text-success mt-3 mb-0">✓ Tồn kho đã được hoàn.</p> }</aside></div></div></div>
