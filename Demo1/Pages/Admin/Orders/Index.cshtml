@page
@model Demo1.Pages.Admin.Orders.IndexModel
@{ ViewData["Title"] = "Quản lý đơn hàng"; }
<div class="container section-block admin-page"><partial name="_AdminNav" /><div class="admin-title"><h1>Đơn hàng</h1></div><form method="get" class="filter-panel mb-4"><div class="row g-2"><div class="col-md-6"><input asp-for="Search" class="form-control" placeholder="Mã đơn hoặc số điện thoại" /></div><div class="col-md-4"><select asp-for="Status" class="form-select"><option value="">Tất cả trạng thái</option>@foreach (var status in Enum.GetValues<OrderStatus>()) { <option value="@status">@status.ToVietnamese()</option> }</select></div><div class="col-md-2"><button class="btn btn-dark w-100" type="submit">Tìm</button></div></div></form><div class="table-responsive content-panel p-0"><table class="table admin-table mb-0"><thead><tr><th>Mã đơn</th><th>Khách hàng</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var item in Model.Orders) { <tr><td><b>@item.OrderCode</b></td><td>@item.CustomerName<small>@item.PhoneNumber</small></td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@item.TotalAmount.ToVnd()</td><td><span class="status-pill status-@item.Status.ToString().ToLowerInvariant()">@item.Status.ToVietnamese()</span></td><td><a class="btn btn-sm btn-outline-dark" asp-page="Details" asp-route-id="@item.Id">Chi tiết</a></td></tr> }</tbody></table></div></div>
