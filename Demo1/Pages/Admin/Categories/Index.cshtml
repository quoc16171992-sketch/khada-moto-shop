@page
@model Demo1.Pages.Admin.Categories.IndexModel
@{ ViewData["Title"] = "Quản lý danh mục"; }
<div class="container section-block admin-page"><partial name="_AdminNav" /><div class="admin-title"><h1>Danh mục</h1><a class="btn btn-racing" asp-page="Create">Thêm danh mục</a></div><div class="table-responsive content-panel p-0"><table class="table admin-table mb-0"><thead><tr><th>Tên</th><th>Slug</th><th>Sản phẩm</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var item in Model.Categories) { <tr><td><b>@item.Name</b><small>@item.Description</small></td><td><code>@item.Slug</code></td><td>@item.Products.Count</td><td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Hoạt động" : "Đã tắt")</span></td><td class="text-nowrap"><a class="btn btn-sm btn-outline-dark" asp-page="Edit" asp-route-id="@item.Id">Sửa</a> <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@item.Id">Xóa</a></td></tr> }</tbody></table></div></div>
