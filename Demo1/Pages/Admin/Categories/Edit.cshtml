@page "{id:int}"
@model Demo1.Pages.Admin.Categories.EditModel
@{ ViewData["Title"] = "Sửa danh mục"; }
<div class="container section-block admin-page"><partial name="_AdminNav" /><h1>Sửa danh mục</h1><form method="post" class="content-panel mt-4"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="Input.Name" class="form-label">Tên danh mục</label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Slug" class="form-label">Slug</label><input asp-for="Input.Slug" class="form-control" /><span asp-validation-for="Input.Slug" class="text-danger"></span></div><div class="mb-3"><label asp-for="Input.Description" class="form-label">Mô tả</label><textarea asp-for="Input.Description" class="form-control"></textarea></div><div class="form-check mb-4"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Đang hoạt động</label></div><button class="btn btn-racing" type="submit">Lưu thay đổi</button> <a class="btn btn-outline-secondary" asp-page="Index">Hủy</a></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
