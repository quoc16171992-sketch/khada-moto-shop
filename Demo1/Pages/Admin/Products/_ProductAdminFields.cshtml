@model Demo1.ViewModels.IProductAdminPageModel
<div class="row g-3"><div class="col-md-8"><label for="Input_Name" class="form-label">Tên sản phẩm</label><input asp-for="Input.Name" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div><div class="col-md-4"><label for="Input_CategoryId" class="form-label">Danh mục</label><select asp-for="Input.CategoryId" class="form-select"><option value="">Chọn danh mục</option>@foreach (var c in Model.Categories) { <option value="@c.Id">@c.Name</option> }</select><span asp-validation-for="Input.CategoryId" class="text-danger"></span></div><div class="col-12"><label for="Input_Slug" class="form-label">Slug</label><input asp-for="Input.Slug" class="form-control" /><span asp-validation-for="Input.Slug" class="text-danger"></span></div><div class="col-12"><label for="Input_ShortDescription" class="form-label">Mô tả ngắn</label><textarea asp-for="Input.ShortDescription" class="form-control"></textarea><span asp-validation-for="Input.ShortDescription" class="text-danger"></span></div><div class="col-12"><label for="Input_Description" class="form-label">Mô tả chi tiết</label><textarea asp-for="Input.Description" class="form-control" rows="6"></textarea><span asp-validation-for="Input.Description" class="text-danger"></span></div><div class="col-md-4"><label for="Input_BasePrice" class="form-label">Giá bán</label><input asp-for="Input.BasePrice" type="number" min="1" step="0.01" inputmode="decimal" class="form-control" /><span asp-validation-for="Input.BasePrice" class="text-danger"></span></div><div class="col-md-4"><label for="Input_CompareAtPrice" class="form-label">Giá cũ</label><input asp-for="Input.CompareAtPrice" type="number" min="0" step="0.01" inputmode="decimal" class="form-control" /><span asp-validation-for="Input.CompareAtPrice" class="text-danger"></span></div><div class="col-md-6"><label for="ProductImage" class="form-label">Ảnh chính (tối đa 5 MB)</label><input asp-for="ProductImage" class="form-control" accept=".jpg,.jpeg,.png,.webp" /><span asp-validation-for="ProductImage" class="text-danger"></span></div><div class="col-md-6"><label for="ProductSecondaryImage" class="form-label">Ảnh thứ hai (tối đa 5 MB)</label><input asp-for="ProductSecondaryImage" class="form-control" accept=".jpg,.jpeg,.png,.webp" /><span asp-validation-for="ProductSecondaryImage" class="text-danger"></span></div><div class="col-12"><label for="ProductGalleryImages" class="form-label">Ảnh bổ sung (chọn được nhiều ảnh, mỗi ảnh tối đa 5 MB)</label><input asp-for="ProductGalleryImages" class="form-control" accept=".jpg,.jpeg,.png,.webp" multiple /><span asp-validation-for="ProductGalleryImages" class="text-danger"></span><small class="text-muted">Khi sửa sản phẩm, chọn ảnh mới tại đây sẽ thay toàn bộ nhóm ảnh bổ sung hiện tại.</small></div><div class="col-12 d-flex gap-4"><div class="form-check"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Đang bán</label></div><div class="form-check"><input asp-for="Input.IsFeatured" class="form-check-input" /><label asp-for="Input.IsFeatured" class="form-check-label">Nổi bật</label></div></div></div>
