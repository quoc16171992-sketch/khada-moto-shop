@page "{id:int}"
@model Demo1.Pages.Admin.Products.EditModel
@{ ViewData["Title"] = "Sửa sản phẩm"; }
<div class="container section-block admin-page"><partial name="_AdminNav" /><h1>Sửa sản phẩm</h1><div class="d-flex flex-wrap gap-3 my-3">@if (!string.IsNullOrWhiteSpace(Model.CurrentImagePath)) { <div><small class="d-block text-muted">Ảnh chính</small><img class="admin-product-preview" src="@Model.CurrentImagePath" alt="Ảnh chính hiện tại" /></div> }@if (!string.IsNullOrWhiteSpace(Model.CurrentSecondaryImagePath)) { <div><small class="d-block text-muted">Ảnh thứ hai</small><img class="admin-product-preview" src="@Model.CurrentSecondaryImagePath" alt="Ảnh thứ hai hiện tại" /></div> }@for (var imageIndex = 0; imageIndex < Model.CurrentGalleryImagePaths.Count; imageIndex++) { <div><small class="d-block text-muted">Ảnh bổ sung @(imageIndex + 3)</small><img class="admin-product-preview" src="@Model.CurrentGalleryImagePaths[imageIndex]" alt="Ảnh bổ sung hiện tại" /></div> }</div><form method="post" enctype="multipart/form-data" class="content-panel"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><partial name="_ProductAdminFields" model="Model" /><div class="mt-4"><button class="btn btn-racing" type="submit">Lưu thay đổi</button> <a class="btn btn-outline-secondary" asp-page="Index">Hủy</a></div></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
