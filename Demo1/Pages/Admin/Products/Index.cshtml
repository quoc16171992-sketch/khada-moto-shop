@page
@model Demo1.Pages.Admin.Products.IndexModel
@{ ViewData["Title"] = "Quản lý sản phẩm"; }
<div class="container section-block admin-page"><partial name="_AdminNav" /><div class="admin-title"><h1>Sản phẩm</h1><a class="btn btn-racing" asp-page="Create">Thêm sản phẩm</a></div><form method="get" class="filter-panel mb-4"><div class="row g-2"><div class="col-md-6"><input asp-for="Search" class="form-control" placeholder="Tìm tên sản phẩm" /></div><div class="col-md-4"><select asp-for="CategoryId" class="form-select"><option value="">Tất cả danh mục</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select></div><div class="col-md-2"><button class="btn btn-dark w-100" type="submit">Tìm</button></div></div></form><div class="table-responsive content-panel p-0"><table class="table admin-table mb-0"><thead><tr><th>Ảnh</th><th>Sản phẩm</th><th>Giá</th><th>Biến thể</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var item in Model.Products) { <tr><td><img class="admin-thumb" src="@(string.IsNullOrWhiteSpace(item.ImagePath) ? "/images/placeholder-product.svg" : item.ImagePath)" alt="@item.Name" /></td><td><b>@item.Name</b><small>@item.Category.Name · <code>@item.Slug</code></small></td><td>@item.BasePrice.ToVnd()</td><td>@item.Variants.Count <a asp-page="Variants" asp-route-id="@item.Id">Quản lý</a></td><td><span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">@(item.IsActive ? "Đang bán" : "Đã tắt")</span>@if (item.IsFeatured) { <span class="badge bg-danger">Nổi bật</span> }</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-dark" asp-page="Edit" asp-route-id="@item.Id">Sửa</a> <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@item.Id">Xóa</a></td></tr> }</tbody></table></div></div>
