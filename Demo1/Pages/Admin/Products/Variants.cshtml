@page "{id:int}"
@model Demo1.Pages.Admin.Products.VariantsModel
@{ ViewData["Title"] = "Biến thể sản phẩm"; }
<div class="container section-block admin-page"><partial name="_AdminNav" /><div class="admin-title"><div><h1>Biến thể</h1><p>@Model.Product.Name · Giá gốc @Model.Product.BasePrice.ToVnd()</p></div><a class="btn btn-outline-dark" asp-page="Edit" asp-route-id="@Model.Product.Id">Sửa sản phẩm</a></div><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="content-panel mb-4"><h2 class="h4">Thêm biến thể</h2><form method="post" asp-page-handler="Add"><div class="row g-2 align-items-end"><div class="col-md-2"><label asp-for="Input.Size" class="form-label">Size</label><input asp-for="Input.Size" class="form-control" /><span asp-validation-for="Input.Size" class="text-danger"></span></div><div class="col-md-2"><label asp-for="Input.Color" class="form-label">Màu</label><input asp-for="Input.Color" class="form-control" /><span asp-validation-for="Input.Color" class="text-danger"></span></div><div class="col-md-2"><label asp-for="Input.Sku" class="form-label">SKU</label><input asp-for="Input.Sku" class="form-control" /><span asp-validation-for="Input.Sku" class="text-danger"></span></div><div class="col-md-2"><label asp-for="Input.StockQuantity" class="form-label">Tồn kho</label><input asp-for="Input.StockQuantity" class="form-control" /></div><div class="col-md-2"><label asp-for="Input.PriceAdjustment" class="form-label">Giá cộng thêm</label><input asp-for="Input.PriceAdjustment" type="number" step="0.01" inputmode="decimal" class="form-control" /></div><div class="col-md-1"><div class="form-check"><input asp-for="Input.IsActive" class="form-check-input" /><label asp-for="Input.IsActive" class="form-check-label">Bật</label></div></div><div class="col-md-1"><button class="btn btn-racing w-100" type="submit">Thêm</button></div></div></form></div>
<div class="content-panel"><h2 class="h4">Danh sách biến thể</h2>@foreach (var item in Model.Variants) { <form method="post" asp-page-handler="Update" class="variant-admin-row"><input type="hidden" name="variantId" value="@item.Id" /><input name="Input.Size" value="@item.Size" class="form-control" aria-label="Size" /><input name="Input.Color" value="@item.Color" class="form-control" aria-label="Màu" /><input name="Input.Sku" value="@item.Sku" class="form-control" aria-label="SKU" /><input name="Input.StockQuantity" value="@item.StockQuantity" type="number" min="0" class="form-control" aria-label="Tồn kho" /><input name="Input.PriceAdjustment" value="@item.PriceAdjustment.ToString(CultureInfo.InvariantCulture)" type="number" step="0.01" inputmode="decimal" class="form-control" aria-label="Giá cộng thêm" /><label class="form-check"><input name="Input.IsActive" type="checkbox" value="true" checked="@item.IsActive" class="form-check-input" /><span>Bật</span></label><button class="btn btn-sm btn-dark" type="submit">Lưu</button><button class="btn btn-sm btn-outline-danger" type="submit" formaction="?handler=Delete&amp;variantId=@item.Id">Xóa</button></form> }</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
