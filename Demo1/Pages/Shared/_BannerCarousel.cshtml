@model IReadOnlyList<Banner>

<section class="hero-section" aria-label="Khuyến mãi nổi bật">
    <div id="khadaBannerCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5000" data-bs-pause="hover">
        <div class="carousel-indicators">
            @if (Model.Count == 0)
            {
                <button type="button" data-bs-target="#khadaBannerCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Banner mặc định"></button>
            }
            else
            {
                @for (var i = 0; i < Model.Count; i++)
                {
                    <button type="button" data-bs-target="#khadaBannerCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Banner @(i + 1)"></button>
                }
            }
        </div>
        <div class="carousel-inner">
            @if (Model.Count == 0)
            {
                <div class="carousel-item active"><div class="banner-slide banner-gradient-1"><div class="container banner-content"><span class="eyebrow">KHADA MOTO SHOP</span><h1>Chinh phục mọi hành trình</h1><p>Khám phá đồ bảo hộ và phụ kiện xe phong cách biker.</p><a class="btn btn-racing" asp-page="/Products/Index">Xem sản phẩm</a></div></div></div>
            }
            else
            {
                @for (var i = 0; i < Model.Count; i++)
                {
                    var banner = Model[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="banner-slide banner-gradient-@((i % 3) + 1)">
                            @if (!string.IsNullOrWhiteSpace(banner.ImagePath)) { <img class="banner-image" src="@banner.ImagePath" alt="@banner.Title" /> }
                            <div class="banner-overlay"></div>
                            <div class="container banner-content">
                                <span class="eyebrow">KHADA MOTO SHOP</span><h1>@banner.Title</h1>
                                @if (!string.IsNullOrWhiteSpace(banner.Subtitle)) { <p>@banner.Subtitle</p> }
                                @if (!string.IsNullOrWhiteSpace(banner.ButtonText) && UrlSafety.IsSafeTargetUrl(banner.TargetUrl)) { <a class="btn btn-racing" href="@banner.TargetUrl">@banner.ButtonText</a> }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#khadaBannerCarousel" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span><span class="visually-hidden">Trước</span></button>
        <button class="carousel-control-next" type="button" data-bs-target="#khadaBannerCarousel" data-bs-slide="next"><span class="carousel-control-next-icon"></span><span class="visually-hidden">Sau</span></button>
    </div>
</section>
